<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="InterviewAssistant.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:InterviewAssistant.Views"
    FlyoutBehavior="Disabled">

    <TabBar>
        <Tab Title="Interview" Icon="mic.png">
            <ShellContent ContentTemplate="{DataTemplate views:MainPage}" Route="MainPage" />
        </Tab>
        <Tab Title="Settings" Icon="gear.png">
            <ShellContent ContentTemplate="{DataTemplate views:SettingsPage}" Route="SettingsPage" />
        </Tab>
    </TabBar>

</Shell>
